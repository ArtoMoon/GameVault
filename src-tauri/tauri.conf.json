{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GameVault",
  "version": "0.3.1",
  "identifier": "com.gamevault.app",
  "build": {
    "frontendDist": "../frontend-dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "yarn dev",
    "beforeBuildCommand": "yarn build"
  },
  "app": {
    "windows": [
      {
        "title": "GameVault – Universal Gaming Dashboard",
        "width": 1360,
        "height": 860,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/node.exe": "node.exe",
      "../.next/standalone": "standalone"
    }
  }
}
