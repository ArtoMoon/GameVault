{
  "name": "mylol",
  "version": "0.3.0",
  "description": "MyLoL League of Legends Alt-Account Dashboard",
  "author": "MyLoL",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/prepare-standalone.cjs",
    "start": "next start",
    "lint": "eslint",
    "electron:dev": "concurrently -k -s first -n \"NEXT,APP\" -c \"cyan,magenta\" \"cross-env PORT=3000 next dev\" \"wait-on http://127.0.0.1:3000 && electron .\"",
    "electron:build": "yarn build && electron-builder --win",
    "electron:build:setup": "yarn build && electron-builder --win nsis",
    "electron:build:portable": "yarn build && electron-builder --win portable",
    "electron:build:dir": "yarn build && electron-builder --dir",
    "release": "node scripts/publish-release.mjs",
    "release:all": "yarn electron:build:setup && node scripts/publish-release.mjs"
  },
  "dependencies": {
    "mongoose": "^9.9.5",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "png-to-ico": "^3.0.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.mylol.dashboard",
    "productName": "MyLoL",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "ArtoMoon",
      "repo": "lolstock"
    },
    "files": [
      "electron/**/*",
      "scripts/**/*",
      ".next/standalone/**/*",
      ".next/static/**/*",
      "public/**/*",
      "package.json"
    ],
    "asar": false,
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyLoL",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "MyLoL-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "MyLoL-Portable-${version}.exe"
    }
  }
}
